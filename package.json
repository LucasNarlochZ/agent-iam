{
    "name": "@agentiam-dev/core",
    "version": "0.6.0",
    "description": "Capability-based policy enforcement for agent CLI actions",
    "type": "module",
    "bin": {
        "agentiam": "dist/index.js"
    },
    "files": [
        "dist",
        "examples",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "npm run build && vitest run --exclude \"tests/integration/real-*.test.ts\"",
        "test:isolated": "node scripts/test-isolated.mjs",
        "test:watch": "vitest",
        "test:real:codex": "node scripts/test-real-harness.mjs codex",
        "test:real:opencode": "node scripts/test-real-harness.mjs opencode",
        "test:real": "node scripts/test-real-harness.mjs all"
    },
    "keywords": [
        "ai-agent",
        "aws",
        "authorization",
        "policy",
        "prolog",
        "mcp",
        "cli",
        "security"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/LucasNarlochZ/agent-iam"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@opencode/plugin": "^2.0.29",
        "tau-prolog": "^0.3.4",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@types/node": "^22.20.5",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
