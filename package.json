{
    "name": "@lucasnarz/agent-iam",
    "version": "0.2.0",
    "description": "Capability-based policy enforcement for agent CLI actions",
    "type": "module",
    "bin": {
        "agentiam": "dist/index.js"
    },
    "files": [
        "dist",
        "examples",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [
        "ai-agent",
        "aws",
        "authorization",
        "policy",
        "prolog",
        "mcp",
        "cli",
        "security"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LucasNarZ/agent-iam.git"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "tau-prolog": "^0.3.4",
        "yaml": "^2.9.0"
    },
    "devDependencies": {
        "@types/node": "^20.17.0",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "typescript": "^7.0.2",
        "vitest": "^2.1.9"
    }
}
